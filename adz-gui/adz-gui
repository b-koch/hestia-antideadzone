    def _make_spin_row(
        self,
        title: str,
        subtitle: str | None,
        low: float,
        high: float,
        step: float,
        digits: int,
        callback: Any,
    ) -> Adw.SpinRow:
        row = Adw.SpinRow.new_with_range(low, high, step)
        row.set_title(title)
        if subtitle:
            row.set_subtitle(subtitle)
        row.set_digits(digits)
        row.connect("notify::value", callback)
        return row

    # ------------------------------------------------------------------
    # State <-> UI Synchronization
    # ------------------------------------------------------------------
    def _current_profile_name(self) -> str:
        return str(self.config["active_profile"])

    def _current_profile(self) -> dict[str, Any]:
        return self.config["profiles"][self._current_profile_name()]

    def _sync_ui_from_config(self) -> None:
        self._updating_ui = True
        try:
            names = list(self.config["profiles"].keys())
            active = self._current_profile_name()
            self.profile_row.set_model(Gtk.StringList.new(names))
            self.profile_row.set_selected(names.index(active))
            self.btn_delete.set_sensitive(len(names) > 1)

            paused = bool(self.config.get("paused", False))
            self.paused_row.set_active(paused)
            self.header_pause_btn.set_active(paused)
            self.header_pause_btn.set_label("Paused" if paused else "Active")

            self.device_match_row.set_text(str(self.config.get("device_name_match", "")))
            self.hz_row.set_value(float(self.config.get("max_output_hz", 250)))
            self.reload_interval_row.set_value(float(self.config.get("reload_interval", 1.0)))
            self.rescan_interval_row.set_value(float(self.config.get("rescan_interval", 1.0)))
            self.debug_rate_row.set_value(float(self.config.get("debug_sample_rate", 0)))
            self.rt_prio_row.set_active(bool(self.config.get("realtime_priority", False)))

            self._sync_stick_ui()
            self._sync_trigger_ui()
            self._refresh_daemon_status()
        finally:
            self._updating_ui = False

    def _sync_stick_ui(self) -> None:
        prof = self._current_profile()
        stick = prof.setdefault(self._active_stick_key, {})

        shape = stick.get("deadzone_shape", "radial")
        idx = SHAPES.index(shape) if shape in SHAPES else 0
        self.shape_row.set_selected(idx)

        self.dz_row.set_value(float(stick.get("deadzone", STICK_DEFAULTS["deadzone"])))
        self.outer_dz_row.set_value(
            float(stick.get("outer_deadzone", STICK_DEFAULTS["outer_deadzone"]))
        )
        self.adz_row.set_value(
            float(stick.get("anti_deadzone", STICK_DEFAULTS["anti_deadzone"]))
        )
        self.curve_row.set_value(float(stick.get("curve", STICK_DEFAULTS["curve"])))
        self.axial_dz_row.set_value(
            float(stick.get("axial_deadzone", STICK_DEFAULTS["axial_deadzone"]))
        )
        self.slope_row.set_value(
            float(
                stick.get(
                    "sloped_dominance_curve", STICK_DEFAULTS["sloped_dominance_curve"]
                )
            )
        )
        self.clamp_row.set_active(
            bool(stick.get("outer_circle_clamp", STICK_DEFAULTS["outer_circle_clamp"]))
        )

        self.curve_preview.update_params(stick)

    def _sync_trigger_ui(self) -> None:
        prof = self._current_profile()
        lt = prof.get("left_trigger", {})
        rt = prof.get("right_trigger", {})

        self.lt_dz_row.set_value(float(lt.get("deadzone", TRIGGER_DEFAULTS["deadzone"])))
        self.lt_outer_dz_row.set_value(
            float(lt.get("outer_deadzone", TRIGGER_DEFAULTS["outer_deadzone"]))
        )
        self.lt_adz_row.set_value(
            float(lt.get("anti_deadzone", TRIGGER_DEFAULTS["anti_deadzone"]))
        )
        self.lt_curve_row.set_value(float(lt.get("curve", TRIGGER_DEFAULTS["curve"])))

        self.rt_dz_row.set_value(float(rt.get("deadzone", TRIGGER_DEFAULTS["deadzone"])))
        self.rt_outer_dz_row.set_value(
            float(rt.get("outer_deadzone", TRIGGER_DEFAULTS["outer_deadzone"]))
        )
        self.rt_adz_row.set_value(
            float(rt.get("anti_deadzone", TRIGGER_DEFAULTS["anti_deadzone"]))
        )
        self.rt_curve_row.set_value(float(rt.get("curve", TRIGGER_DEFAULTS["curve"])))

    # ------------------------------------------------------------------
    # Event Handlers
    # ------------------------------------------------------------------
    @staticmethod
    def _set_clean_field(target: dict[str, Any], key: str, value: Any, default: Any) -> None:
        """Update key if already present or non-default, keeping profiles uncluttered."""
        if key in target or value != default:
            target[key] = value

    def _on_header_pause_toggled(self, btn: Gtk.ToggleButton) -> None:
        if self._updating_ui:
            return
        self.paused_row.set_active(btn.get_active())

    def _on_global_changed(self, *_args: Any) -> None:
        if self._updating_ui:
            return
        paused = self.paused_row.get_active()
        self.config["paused"] = paused
        self.config["device_name_match"] = self.device_match_row.get_text().strip()
        self.config["max_output_hz"] = int(round(self.hz_row.get_value()))
        self._set_clean_field(
            self.config, "reload_interval", round(self.reload_interval_row.get_value(), 2), 1.0
        )
        self._set_clean_field(
            self.config, "rescan_interval", round(self.rescan_interval_row.get_value(), 2), 1.0
        )
        self._set_clean_field(
            self.config, "debug_sample_rate", int(round(self.debug_rate_row.get_value())), 0
        )
        self._set_clean_field(
            self.config, "realtime_priority", self.rt_prio_row.get_active(), False
        )

        self._updating_ui = True
        self.header_pause_btn.set_active(paused)
        self.header_pause_btn.set_label("Paused" if paused else "Active")
        self._updating_ui = False

        self._refresh_daemon_status()
        self._schedule_save()

    def _on_profile_selected(self, row: Adw.ComboRow, _pspec: Any) -> None:
        if self._updating_ui:
            return
        item = row.get_selected_item()
        if item is None:
            return
        name = item.get_string()
        if name in self.config["profiles"] and name != self.config.get("active_profile"):
            self.config["active_profile"] = name
            self._sync_ui_from_config()
            self._schedule_save()
            self._show_toast(f"Switched to profile “{name}”")

    def _on_stick_target_toggled(self, _btn: Gtk.ToggleButton) -> None:
        if self._updating_ui:
            return
        self._active_stick_key = "left" if self.left_stick_btn.get_active() else "right"
        self._updating_ui = True
        try:
            self._sync_stick_ui()
        finally:
            self._updating_ui = False

    def _on_stick_param_changed(self, *_args: Any) -> None:
        if self._updating_ui:
            return
        stick = self._current_profile().setdefault(self._active_stick_key, {})
        shape_idx = self.shape_row.get_selected()
        shape = SHAPES[shape_idx] if 0 <= shape_idx < len(SHAPES) else "radial"

        stick["deadzone_shape"] = shape
        stick["deadzone"] = round(self.dz_row.get_value(), 4)
        self._set_clean_field(
            stick,
            "outer_deadzone",
            round(self.outer_dz_row.get_value(), 4),
            STICK_DEFAULTS["outer_deadzone"],
        )
        stick["anti_deadzone"] = round(self.adz_row.get_value(), 4)
        stick["curve"] = round(self.curve_row.get_value(), 3)
        self._set_clean_field(
            stick,
            "axial_deadzone",
            round(self.axial_dz_row.get_value(), 4),
            STICK_DEFAULTS["axial_deadzone"],
        )
        self._set_clean_field(
            stick,
            "sloped_dominance_curve",
            round(self.slope_row.get_value(), 3),
            STICK_DEFAULTS["sloped_dominance_curve"],
        )
        self._set_clean_field(
            stick,
            "outer_circle_clamp",
            self.clamp_row.get_active(),
            STICK_DEFAULTS["outer_circle_clamp"],
        )

        self.curve_preview.update_params(stick)
        self._schedule_save()

    def _on_copy_stick_settings(self, _btn: Gtk.Button) -> None:
        prof = self._current_profile()
        other = "right" if self._active_stick_key == "left" else "left"
        prof[other] = copy.deepcopy(prof.get(self._active_stick_key, {}))
        self._schedule_save()
        label = "Right Stick" if other == "right" else "Left Stick"
        self._show_toast(f"Copied settings to {label}")

    def _on_trigger_changed(self, *_args: Any) -> None:
        if self._updating_ui:
            return
        prof = self._current_profile()

        lt_vals = {
            "deadzone": round(self.lt_dz_row.get_value(), 3),
            "outer_deadzone": round(self.lt_outer_dz_row.get_value(), 3),
            "anti_deadzone": round(self.lt_adz_row.get_value(), 3),
            "curve": round(self.lt_curve_row.get_value(), 2),
        }
        if "left_trigger" in prof or lt_vals != TRIGGER_DEFAULTS:
            lt = prof.setdefault("left_trigger", {})
            for k, v in lt_vals.items():
                self._set_clean_field(lt, k, v, TRIGGER_DEFAULTS[k])

        rt_vals = {
            "deadzone": round(self.rt_dz_row.get_value(), 3),
            "outer_deadzone": round(self.rt_outer_dz_row.get_value(), 3),
            "anti_deadzone": round(self.rt_adz_row.get_value(), 3),
            "curve": round(self.rt_curve_row.get_value(), 2),
        }
        if "right_trigger" in prof or rt_vals != TRIGGER_DEFAULTS:
            rt = prof.setdefault("right_trigger", {})
            for k, v in rt_vals.items():
                self._set_clean_field(rt, k, v, TRIGGER_DEFAULTS[k])

        self._schedule_save()

    # ------------------------------------------------------------------
    # Profile CRUD Dialogs
    # ------------------------------------------------------------------
    def _prompt_profile_name(
        self, heading: str, body: str, initial: str, confirm_label: str, on_accept: Any
    ) -> None:
        dialog = Adw.AlertDialog(heading=heading, body=body)
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("confirm", confirm_label)
        dialog.set_response_appearance("confirm", Adw.ResponseAppearance.SUGGESTED)
        dialog.set_default_response("confirm")

        entry = Gtk.Entry(text=initial)
        entry.set_activates_default(True)
        dialog.set_extra_child(entry)

        def _handle_response(dlg: Adw.AlertDialog, result: Gio.AsyncResult) -> None:
            if dlg.choose_finish(result) == "confirm":
                name = entry.get_text().strip()
                if name:
                    on_accept(name)

        dialog.choose(self, None, _handle_response)

    def _on_new_profile(self, _btn: Gtk.Button) -> None:
        def _create(name: str) -> None:
            if name in self.config["profiles"]:
                self._show_toast(f"Profile “{name}” already exists")
                return
            self.config["profiles"][name] = copy.deepcopy(NEW_PROFILE_TEMPLATE)
            self.config["active_profile"] = name
            self._sync_ui_from_config()
            self._schedule_save()
            self._show_toast(f"Created profile “{name}”")

        self._prompt_profile_name(
            "New Profile",
            "Enter a unique name for the new controller profile:",
            "",
            "Create",
            _create,
        )

    def _on_duplicate_profile(self, _btn: Gtk.Button) -> None:
        src = self._current_profile_name()

        def _duplicate(name: str) -> None:
            if name in self.config["profiles"]:
                self._show_toast(f"Profile “{name}” already exists")
                return
            self.config["profiles"][name] = copy.deepcopy(self.config["profiles"][src])
            self.config["active_profile"] = name
            self._sync_ui_from_config()
            self._schedule_save()
            self._show_toast(f"Duplicated “{src}” → “{name}”")

        self._prompt_profile_name(
            "Duplicate Profile",
            f"Create a copy of “{src}”:",
            f"{src}-copy",
            "Duplicate",
            _duplicate,
        )

    def _on_rename_profile(self, _btn: Gtk.Button) -> None:
        old = self._current_profile_name()

        def _rename(new_name: str) -> None:
            if new_name == old:
                return
            if new_name in self.config["profiles"]:
                self._show_toast(f"Profile “{new_name}” already exists")
                return
            rebuilt: dict[str, Any] = {}
            for k, v in self.config["profiles"].items():
                rebuilt[new_name if k == old else k] = v
            self.config["profiles"] = rebuilt
            self.config["active_profile"] = new_name
            self._sync_ui_from_config()
            self._schedule_save()
            self._show_toast(f"Renamed to “{new_name}”")

        self._prompt_profile_name(
            "Rename Profile",
            f"Enter a new name for “{old}”:",
            old,
            "Rename",
            _rename,
        )

    def _on_delete_profile(self, _btn: Gtk.Button) -> None:
        if len(self.config["profiles"]) <= 1:
            return
        target = self._current_profile_name()
        dialog = Adw.AlertDialog(
            heading=f"Delete “{target}”?",
            body="This profile will be permanently removed from config.json.",
        )
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("delete", "Delete")
        dialog.set_response_appearance("delete", Adw.ResponseAppearance.DESTRUCTIVE)

        def _handle(dlg: Adw.AlertDialog, result: Gio.AsyncResult) -> None:
            if dlg.choose_finish(result) == "delete":
                del self.config["profiles"][target]
                self.config["active_profile"] = next(iter(self.config["profiles"]))
                self._sync_ui_from_config()
                self._schedule_save()
                self._show_toast(f"Deleted profile “{target}”")

        dialog.choose(self, None, _handle)

    # ------------------------------------------------------------------
    # Menu Actions
    # ------------------------------------------------------------------
    def _register_actions(self) -> None:
        actions = {
            "show_devices": self._action_show_devices,
            "validate_config": self._action_validate_config,
            "reload_disk": self._action_reload_disk,
        }
        for name, fn in actions.items():
            act = Gio.SimpleAction.new(name, None)
            act.connect("activate", fn)
            self.add_action(act)

    def _run_cli_dialog(self, title: str, args: list[str]) -> None:
        try:
            proc = subprocess.run(
                args,
                capture_output=True,
                text=True,
                timeout=5,
                check=False,
            )
            output = (proc.stdout or proc.stderr or "(no output)").strip()
        except FileNotFoundError:
            output = f"Command not found: {args[0]}"
        except Exception as exc:
            output = str(exc)

        dialog = Adw.AlertDialog(heading=title, body=output)
        dialog.add_response("close", "Close")
        dialog.choose(self, None, lambda d, r: d.choose_finish(r))

    def _action_show_devices(self, *_args: Any) -> None:
        self._run_cli_dialog("Detected Input Devices", ["adz", "devices"])

    def _action_validate_config(self, *_args: Any) -> None:
        self._commit_save()
        self._run_cli_dialog("Config Validation", ["adz", "validate"])

    def _action_reload_disk(self, *_args: Any) -> None:
        self._load_config()
        self._sync_ui_from_config()
        self._show_toast(self._load_error or "Reloaded configuration from disk")


class AdzApplication(Adw.Application):
    def __init__(self, config_path: Path) -> None:
        super().__init__(
            application_id=APP_ID,
            flags=Gio.ApplicationFlags.FLAGS_NONE,
        )
        self.config_path = config_path

    def do_activate(self) -> None:
        win = self.props.active_window
        if not win:
            win = AdzWindow(self, self.config_path)
        win.present()


def main() -> int:
    parser = argparse.ArgumentParser(description="Hestia Anti-Deadzone GUI")
    parser.add_argument(
        "-c",
        "--config",
        type=Path,
        default=get_default_config_path(),
        help="Path to config.json (default: ~/.config/hestia/anti-deadzone/config.json)",
    )
    args, remaining = parser.parse_known_args()
    app = AdzApplication(args.config.expanduser())
    return app.run([sys.argv[0], *remaining])


if __name__ == "__main__":
    raise SystemExit(main())