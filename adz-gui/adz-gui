        super().__init__(application=app)
        self.set_title("Hestia Anti-Deadzone")
        self.set_default_size(760, 900)

        self.config_path = config_path
        self.pid_path = get_pid_path()
        self.config: dict[str, Any] = {}
        self._load_error: str | None = None
        self._updating_ui = False
        self._save_timer_id: int | None = None
        self._active_stick_key = "right"

        self._load_config()
        self._build_ui()
        self._sync_ui_from_config()

        if self._load_error:
            GLib.idle_add(self._show_toast, self._load_error)

        GLib.timeout_add_seconds(2, self._refresh_daemon_status)

    # ------------------------------------------------------------------
    # Config I/O & Daemon IPC
    # ------------------------------------------------------------------
    def _load_config(self) -> None:
        self._load_error = None
        if not self.config_path.exists():
            self._load_error = f"Config not found at {self.config_path}"
            self.config = {
                "paused": False,
                "device_name_match": "",
                "active_profile": "default",
                "max_output_hz": 250,
                "reload_interval": 1.0,
                "rescan_interval": 1.0,
                "debug_sample_rate": 0,
                "realtime_priority": False,
                "profiles": {
                    "default": copy.deepcopy(NEW_PROFILE_TEMPLATE),
                },
            }
            return

        try:
            raw = json.loads(self.config_path.read_text(encoding="utf-8"))
        except Exception as exc:
            self._load_error = f"JSON parse error: {exc}"
            self.config = {
                "active_profile": "default",
                "profiles": {"default": copy.deepcopy(NEW_PROFILE_TEMPLATE)},
            }
            return

        if not isinstance(raw, dict):
            self._load_error = "Invalid config.json root (expected object)"
            raw = {}

        profiles = raw.get("profiles")
        if not isinstance(profiles, dict) or not profiles:
            raw["profiles"] = {"default": copy.deepcopy(NEW_PROFILE_TEMPLATE)}

        for name, prof in raw["profiles"].items():
            if not isinstance(prof, dict):
                raw["profiles"][name] = copy.deepcopy(NEW_PROFILE_TEMPLATE)
                continue
            prof.setdefault("left", {})
            prof.setdefault("right", {})

        if raw.get("active_profile") not in raw["profiles"]:
            raw["active_profile"] = next(iter(raw["profiles"]))

        self.config = raw

    def _write_config_atomic(self, notify_daemon: bool = True) -> None:
        self.config_path.parent.mkdir(parents=True, exist_ok=True)
        payload = json.dumps(self.config, indent=2, sort_keys=False) + "\n"
        fd, tmp_name = tempfile.mkstemp(
            prefix=".config-",
            suffix=".tmp",
            dir=str(self.config_path.parent),
        )
        try:
            with os.fdopen(fd, "w", encoding="utf-8") as handle:
                handle.write(payload)
                handle.flush()
                os.fsync(handle.fileno())
            os.replace(tmp_name, self.config_path)
        finally:
            if os.path.exists(tmp_name):
                os.unlink(tmp_name)

        if notify_daemon:
            self._signal_daemon_reload()

    def _schedule_save(self) -> None:
        if self._updating_ui:
            return
        if self._save_timer_id is not None:
            GLib.source_remove(self._save_timer_id)
        self._save_timer_id = GLib.timeout_add(150, self._commit_save)

    def _commit_save(self) -> bool:
        self._save_timer_id = None
        try:
            self._write_config_atomic(notify_daemon=True)
        except Exception as exc:
            self._show_toast(f"Save failed: {exc}")
        return False

    def _get_daemon_pid(self) -> int | None:
        if not self.pid_path.exists():
            return None
        try:
            pid = int(self.pid_path.read_text(encoding="utf-8").strip())
            os.kill(pid, 0)
            return pid
        except (ValueError, ProcessLookupError, PermissionError, OSError):
            return None

    def _signal_daemon_reload(self) -> None:
        pid = self._get_daemon_pid()
        if pid is not None:
            try:
                os.kill(pid, signal.SIGHUP)
            except OSError:
                pass

    def _refresh_daemon_status(self) -> bool:
        pid = self._get_daemon_pid()
        paused = bool(self.config.get("paused", False))
        path_hint = str(self.config_path).replace(str(Path.home()), "~")
        if pid is None:
            self.window_title.set_subtitle(f"Daemon inactive · {path_hint}")
        elif paused:
            self.window_title.set_subtitle(f"Paused · PID {pid} · {path_hint}")
        else:
            self.window_title.set_subtitle(f"Active · PID {pid} · {path_hint}")
        return True

