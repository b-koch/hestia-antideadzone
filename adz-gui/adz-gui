def get_default_config_path() -> Path:
    base = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
    return base / "hestia" / "anti-deadzone" / "config.json"


def get_pid_path() -> Path:
    runtime = Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"))
    return runtime / "hestia-antideadzone.pid"


class ResponseCurvePreview(Gtk.DrawingArea):
    """Real-time Cairo preview of raw-to-virtual deflection, deadzones, and gamma curve."""

    def __init__(self) -> None:
        super().__init__()
        self.set_content_width(280)
        self.set_content_height(185)
        self.set_hexpand(True)
        self.params: dict[str, Any] = copy.deepcopy(STICK_DEFAULTS)
        self.set_draw_func(self._on_draw)

    def update_params(self, params: dict[str, Any]) -> None:
        self.params = copy.deepcopy(STICK_DEFAULTS)
        self.params.update(params)
        self.queue_draw()

    def _eval_curve(self, x: float) -> float:
        dz = float(self.params.get("deadzone", 0.0))
        outer_dz = float(self.params.get("outer_deadzone", 0.0))
        adz = float(self.params.get("anti_deadzone", 0.0))
        gamma = max(0.05, float(self.params.get("curve", 1.0)))
        max_in = max(dz + 0.001, 1.0 - outer_dz)

        if x <= dz:
            return 0.0
        if x >= max_in:
            return 1.0
        norm = (x - dz) / (max_in - dz)
        return min(1.0, adz + (1.0 - adz) * math.pow(norm, gamma))

    def _on_draw(self, _area: Gtk.DrawingArea, cr: Any, width: int, height: int) -> None:
        pad = 16.0
        w = max(10.0, width - 2 * pad)
        h = max(10.0, height - 2 * pad)

        cr.set_source_rgba(0.5, 0.5, 0.5, 0.08)
        cr.rectangle(pad, pad, w, h)
        cr.fill()

        # 25% grid lines
        cr.set_line_width(1.0)
        cr.set_source_rgba(0.5, 0.5, 0.5, 0.18)
        for i in range(1, 4):
            frac = i * 0.25
            cr.move_to(pad + frac * w, pad)
            cr.line_to(pad + frac * w, pad + h)
            cr.move_to(pad, pad + frac * h)
            cr.line_to(pad + w, pad + frac * h)
        cr.stroke()

        # 1:1 linear diagonal reference
        cr.set_dash([4.0, 4.0])
        cr.set_source_rgba(0.5, 0.5, 0.5, 0.35)
        cr.move_to(pad, pad + h)
        cr.line_to(pad + w, pad)
        cr.stroke()
        cr.set_dash([])

        dz = float(self.params.get("deadzone", 0.0))
        outer_dz = float(self.params.get("outer_deadzone", 0.0))

        # Inner deadzone cutoff line
        if 0.0 < dz < 1.0:
            cr.set_source_rgba(0.90, 0.35, 0.30, 0.55)
            cr.set_line_width(1.2)
            cr.move_to(pad + dz * w, pad)
            cr.line_to(pad + dz * w, pad + h)
            cr.stroke()

        # Outer deadzone saturation line
        if 0.0 < outer_dz < 1.0:
            sat_x = 1.0 - outer_dz
            cr.set_source_rgba(0.95, 0.65, 0.20, 0.55)
            cr.set_line_width(1.2)
            cr.move_to(pad + sat_x * w, pad)
            cr.line_to(pad + sat_x * w, pad + h)
            cr.stroke()

        # Shaped response curve
        cr.set_source_rgba(0.21, 0.52, 0.89, 0.95)
        cr.set_line_width(2.4)
        steps = 200
        for i in range(steps + 1):
            x = i / steps
            y = self._eval_curve(x)
            px = pad + x * w
            py = pad + (1.0 - y) * h
            if i == 0:
                cr.move_to(px, py)
            else:
                cr.line_to(px, py)
        cr.stroke()

        cr.set_source_rgba(0.5, 0.5, 0.5, 0.3)
        cr.set_line_width(1.0)
        cr.rectangle(pad, pad, w, h)
        cr.stroke()


class AdzWindow(Adw.ApplicationWindow):
